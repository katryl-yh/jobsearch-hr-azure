# Builder stage: Install dependencies with uv package manager
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

# UV package manager configuration
# UV_COMPILE_BYTECODE: Pre-compile Python files to .pyc for faster startup
# UV_LINK_MODE: Copy files instead of hardlinking for reliability
# UV_PYTHON_DOWNLOADS: Don't download Python (use system Python)
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# Install dependencies only (cached layer)
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-workspace --no-dev

# Copy application code
COPY pyproject.toml uv.lock /app/
COPY dagster /app/dagster
COPY dbt /app/dbt

# Install workspace package
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package jobmarket_pipelines --no-dev

# Runtime stage: Minimal image with only necessary files
FROM python:3.12-slim-bookworm AS runtime

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/dagster /app/dagster
COPY --from=builder /app/dbt /app/dbt

# Python runtime configuration
# PATH: Add virtualenv binaries to PATH
# PYTHONPATH: Python module search paths
# PYTHONUNBUFFERED: Disable output buffering for real-time logs
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/dagster/src:/app" \
    PYTHONUNBUFFERED=1

# Application-specific configuration
# DAGSTER_HOME: Directory for Dagster metadata, logs, and storage
# DBT_PROFILES_DIR: Directory containing DBT profiles.yml (connection configs)
# DBT_PROJECT_DIR: Root directory of the DBT project
# DUCKDB_PATH: Full path to DuckDB database file
ENV DBT_PROFILES_DIR=/mnt/.dbt \
    DBT_PROJECT_DIR=/app/dbt/jobmarket_dbt \
    DUCKDB_PATH=/mnt/data/warehouse.duckdb

# Cost-saving fix for dev-container: Set dagster_home/storage to /tmp/
ENV DAGSTER_HOME=/tmp/dagster_home \
    DAGSTER_SQLITE_STORAGE_BASE_DIR=/tmp/dagster_home/storage
RUN mkdir -p /tmp/dagster_home/storage
COPY --from=builder /app/dagster/dagster.yaml /tmp/dagster_home/dagster.yaml

WORKDIR /app
EXPOSE 3000

# Start Dagster web server on all interfaces
CMD ["dagster", "dev", \
     "-h", "0.0.0.0", "-p", "3000", \
     "-m", "jobmarket_pipelines.definitions"]